<section class="hm-intro section-pad">
  <div class="page-width hm-intro__grid{% if section.settings.layout == 'text_first' %} hm-intro__grid--reverse{% endif %}">
    <div class="hm-intro__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '500, 750, 1000, 1400', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'lazy', alt: section.settings.image_alt }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="hm-intro__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="display">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte hm-intro__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="link-arrow" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>{%- endif -%}
    </div>
  </div>
</section>

<style>
  .hm-intro__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, .75fr); align-items: center; gap: clamp(40px, 8vw, 130px); }
  .hm-intro__grid--reverse .hm-intro__media { order: 2; }
  .hm-intro__media { min-height: 560px; background: var(--sand); overflow: hidden; }
  .hm-intro__media img, .hm-intro__media svg { width: 100%; height: 100%; min-height: 560px; object-fit: cover; display: block; }
  .hm-intro__content h2 { margin: 15px 0 24px; font-size: clamp(2.8rem, 5vw, 5.6rem); }
  .hm-intro__text { max-width: 520px; margin-bottom: 28px; color: var(--muted); font-size: 1rem; line-height: 1.8; }
  @media (max-width: 899px) {
    .hm-intro__grid { grid-template-columns: 1fr; gap: 34px; }
    .hm-intro__grid--reverse .hm-intro__media { order: initial; }
    .hm-intro__media, .hm-intro__media img, .hm-intro__media svg { min-height: 420px; }
  }
</style>

{% schema %}
{
  "name": "Imagem e texto Handmade",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "text", "id": "image_alt", "label": "Descrição da imagem", "default": "Detalhes de uma peça artesanal" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "image_first", "options": [{ "value": "image_first", "label": "Imagem primeiro" }, { "value": "text_first", "label": "Texto primeiro" }] },
    { "type": "text", "id": "eyebrow", "label": "Linha superior", "default": "O luxo do tempo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Feito devagar. Feito para durar." },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Cada ponto revela o tempo dedicado à peça e torna cada criação verdadeiramente única.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto do link", "default": "Descobrir a coleção" },
    { "type": "url", "id": "button_link", "label": "Destino do link" }
  ],
  "presets": [{ "name": "Imagem e texto Handmade" }]
}
{% endschema %}

