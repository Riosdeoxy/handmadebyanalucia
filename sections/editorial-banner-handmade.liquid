<section class="hm-editorial">
  <div class="hm-editorial__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'lazy', alt: section.settings.image_alt }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    <div class="hm-editorial__shade"></div>
    <div class="hm-editorial__content page-width">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="display">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.button_label != blank -%}<a class="button button--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</section>

<style>
  .hm-editorial__media { position: relative; min-height: min(76vh, 760px); display: grid; overflow: hidden; background: var(--brown); color: var(--paper); }
  .hm-editorial__media > img, .hm-editorial__media > svg, .hm-editorial__shade, .hm-editorial__content { grid-area: 1 / 1; }
  .hm-editorial__media > img, .hm-editorial__media > svg { width: 100%; height: 100%; min-height: inherit; object-fit: cover; display: block; }
  .hm-editorial__shade { z-index: 1; background: linear-gradient(90deg, rgba(40,29,24,.65), rgba(40,29,24,.08)); }
  .hm-editorial__content { z-index: 2; align-self: center; width: 100%; }
  .hm-editorial__content .eyebrow { color: var(--paper); }
  .hm-editorial__content h2 { max-width: 800px; margin: 18px 0 30px; color: inherit; font-size: clamp(3.1rem, 6.5vw, 7rem); }
</style>

{% schema %}
{
  "name": "Banner editorial Handmade",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "text", "id": "image_alt", "label": "Descrição da imagem", "default": "Bolsa Handmade em um cenário natural" },
    { "type": "text", "id": "eyebrow", "label": "Linha superior", "default": "Naturalmente singular" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Sua história, levada à mão." },
    { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Escolher a minha" },
    { "type": "url", "id": "button_link", "label": "Destino do botão" }
  ],
  "presets": [{ "name": "Banner editorial Handmade" }]
}
{% endschema %}

