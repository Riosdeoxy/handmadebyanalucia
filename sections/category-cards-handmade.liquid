<section class="hm-categories section-pad">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.view_all_label != blank -%}<a class="link-arrow" href="{{ routes.collections_url }}">{{ section.settings.view_all_label | escape }} <span aria-hidden="true">↗</span></a>{%- endif -%}
    </div>
    <div class="hm-categories__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_collection = block.settings.collection
          assign card_image = block.settings.image
          if card_image == blank and card_collection != blank
            assign card_image = card_collection.featured_image
          endif
          assign card_url = block.settings.link
          if card_url == blank and card_collection != blank
            assign card_url = card_collection.url
          endif
          assign card_url = card_url | default: routes.all_products_collection_url
          assign card_title = block.settings.title
          if card_title == blank and card_collection != blank
            assign card_title = card_collection.title
          endif
        -%}
        <article class="hm-category" {{ block.shopify_attributes }}>
          <a href="{{ card_url }}" class="hm-category__link">
            <div class="hm-category__media">
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 1000 | image_tag: widths: '360, 540, 720, 1000', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: card_title }}
              {%- else -%}
                <div class="hm-category__placeholder hm-category__placeholder--{{ forloop.index }}" aria-hidden="true"></div>
              {%- endif -%}
            </div>
            <div class="hm-category__caption">
              <h3>{{ card_title | default: 'Coleção' | escape }}</h3>
              <span>{{ section.settings.explore_label | escape }} <span aria-hidden="true">↗</span></span>
            </div>
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .hm-categories { background: var(--ivory); }
  .hm-categories__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .hm-category__link { color: inherit; text-decoration: none; }
  .hm-category__media { aspect-ratio: 3 / 4; overflow: hidden; background: var(--sand); }
  .hm-category__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .hm-category__link:hover img { transform: scale(1.025); }
  .hm-category__placeholder { width: 100%; height: 100%; background: linear-gradient(145deg, var(--sand), var(--blush)); }
  .hm-category__placeholder--2 { background: linear-gradient(145deg, var(--sage), var(--ivory)); }
  .hm-category__placeholder--3 { background: linear-gradient(145deg, var(--terracotta), var(--sand)); }
  .hm-category__placeholder--4 { background: linear-gradient(145deg, var(--brown), var(--blush)); }
  .hm-category__caption { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 16px 2px 4px; }
  .hm-category__caption h3 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.3rem, 2vw, 1.8rem); font-weight: 400; }
  .hm-category__caption > span { color: var(--muted); font-size: .64rem; letter-spacing: .13em; text-transform: uppercase; white-space: nowrap; }
  @media (max-width: 899px) { .hm-categories__grid { grid-template-columns: repeat(2, 1fr); row-gap: 34px; } }
  @media (max-width: 499px) { .hm-categories__grid { gap: 8px; row-gap: 28px; } .hm-category__caption { display: block; } .hm-category__caption > span { display: inline-block; margin-top: 7px; } }
</style>

{% schema %}
{
  "name": "Categorias Handmade",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Linha superior", "default": "Encontre a sua" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Coleções." },
    { "type": "text", "id": "view_all_label", "label": "Texto de ver todas", "default": "Ver todas" },
    { "type": "text", "id": "explore_label", "label": "Texto de explorar", "default": "Explorar" }
  ],
  "blocks": [
    { "type": "category", "name": "Categoria", "settings": [
      { "type": "collection", "id": "collection", "label": "Coleção" },
      { "type": "image_picker", "id": "image", "label": "Imagem alternativa" },
      { "type": "text", "id": "title", "label": "Título personalizado" },
      { "type": "url", "id": "link", "label": "Link personalizado" }
    ] }
  ],
  "presets": [{ "name": "Categorias Handmade", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}

