{%- liquid
  assign hero_loading = 'eager'
  assign hero_priority = 'high'
  if section.index > 1
    assign hero_loading = 'lazy'
    assign hero_priority = 'auto'
  endif
-%}
<section class="hm-hero" aria-labelledby="HeroTitle-{{ section.id }}">
  <div class="hm-hero__media">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 500 }} 500w, {{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1000 }} 1000w"
            sizes="100vw"
            width="{{ section.settings.image_mobile.width }}"
            height="{{ section.settings.image_mobile.height }}"
          >
        {%- endif -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hm-hero__image', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', loading: hero_loading, fetchpriority: hero_priority, preload: true, alt: section.settings.image_alt }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hm-hero__image placeholder-svg' }}
    {%- endif -%}
    <div class="hm-hero__shade"></div>
  </div>
  <div class="hm-hero__content page-width">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow hm-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 id="HeroTitle-{{ section.id }}" class="display">{{ section.settings.heading | escape }}</h1>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="hm-hero__text rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}<a class="button button--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
  </div>
</section>

<style>
  .hm-hero { position: relative; min-height: min(82vh, 820px); display: grid; color: #fffdf9; overflow: hidden; background: var(--brown); }
  .hm-hero__media, .hm-hero__shade, .hm-hero__content { grid-area: 1 / 1; }
  .hm-hero__media, .hm-hero__media picture { min-height: inherit; display: block; }
  .hm-hero__image { width: 100%; height: 100%; min-height: inherit; object-fit: cover; object-position: center; }
  .hm-hero__shade { z-index: 1; background: linear-gradient(90deg, rgba(38,25,20,.68) 0%, rgba(38,25,20,.28) 54%, rgba(38,25,20,.08) 100%); }
  .hm-hero__content { z-index: 2; align-self: end; width: 100%; padding-top: 110px; padding-bottom: 88px; }
  .hm-hero__content h1 { max-width: 760px; margin: 14px 0 24px; font-size: clamp(3.4rem, 7vw, 7.5rem); color: inherit; }
  .hm-hero__eyebrow { color: inherit; }
  .hm-hero__text { max-width: 520px; margin-bottom: 30px; font-size: clamp(1rem, 1.6vw, 1.22rem); line-height: 1.6; }
  @media (max-width: 749px) {
    .hm-hero { min-height: 74vh; }
    .hm-hero__shade { background: linear-gradient(0deg, rgba(38,25,20,.72) 0%, rgba(38,25,20,.08) 72%); }
    .hm-hero__content { padding-bottom: 48px; }
    .hm-hero__content h1 { font-size: clamp(3rem, 15vw, 5rem); }
  }
</style>

{% schema %}
{
  "name": "Hero Handmade",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem para desktop" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem para celular" },
    { "type": "text", "id": "image_alt", "label": "Descrição da imagem", "default": "Bolsas artesanais Handmade by Ana Lucia" },
    { "type": "text", "id": "eyebrow", "label": "Linha superior", "default": "Crochê autoral · feito à mão" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Peças que carregam histórias." },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Bolsas produzidas uma a uma, com tempo, cuidado e matéria-prima escolhida.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Conheça a coleção" },
    { "type": "url", "id": "button_link", "label": "Link do botão" }
  ],
  "presets": [{ "name": "Hero Handmade" }]
}
{% endschema %}

