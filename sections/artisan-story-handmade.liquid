<section class="hm-artisan section-pad">
  <div class="page-width hm-artisan__grid">
    <div class="hm-artisan__content">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="display">{{ section.settings.heading | escape }}</h2>
      <div class="rte hm-artisan__text">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}<a class="link-arrow" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>{%- endif -%}
    </div>
    <div class="hm-artisan__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '500, 750, 1000, 1400', sizes: '(min-width: 900px) 52vw, 100vw', loading: 'lazy', alt: section.settings.image_alt }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .hm-artisan { background: var(--blush); }
  .hm-artisan__grid { display: grid; grid-template-columns: minmax(280px, .72fr) minmax(0, 1.28fr); align-items: center; gap: clamp(44px, 9vw, 150px); }
  .hm-artisan__content { padding-left: clamp(0px, 4vw, 70px); }
  .hm-artisan__content h2 { margin: 16px 0 24px; font-size: clamp(2.8rem, 5vw, 5.5rem); }
  .hm-artisan__text { max-width: 510px; margin-bottom: 30px; color: var(--brown); line-height: 1.8; }
  .hm-artisan__media { min-height: 650px; overflow: hidden; }
  .hm-artisan__media img, .hm-artisan__media svg { width: 100%; height: 100%; min-height: 650px; display: block; object-fit: cover; }
  @media (max-width: 899px) { .hm-artisan__grid { grid-template-columns: 1fr; } .hm-artisan__content { padding: 0; } .hm-artisan__media, .hm-artisan__media img, .hm-artisan__media svg { min-height: 480px; } }
</style>

{% schema %}
{
  "name": "História da artesã",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "text", "id": "image_alt", "label": "Descrição da imagem", "default": "Ana Lucia produzindo uma peça artesanal" },
    { "type": "text", "id": "eyebrow", "label": "Linha superior", "default": "A artesã" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Feito pelas mãos de Ana Lucia." },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Entre fios, cores e memórias, Ana Lucia transforma o crochê em peças contemporâneas, cheias de presença e afeto.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto do link", "default": "Conheça a nossa história" },
    { "type": "url", "id": "button_link", "label": "Destino do link" }
  ],
  "presets": [{ "name": "História da artesã" }]
}
{% endschema %}

